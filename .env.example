# Copy to .env and fill in what you need: `cp .env.example .env`
# .env is gitignored and auto-loaded by pydantic-settings (see src/jenkins_watchdog/config.py).
#
# Port and Valkey vars are intentionally NOT set here — scripts/dev.sh injects
# per-instance values (WATCHDOG_PORT, WATCHDOG_VALKEY_HOST/PORT) automatically
# so multiple git-worktree instances don't collide. Don't set them in .env.

# Required for LLM-based investigation (Claude tool-use). Without it, scans
# still detect findings and selected incidents retain a low-confidence partial result.
WATCHDOG_ANTHROPIC_API_KEY=
WATCHDOG_MAX_TOOL_ROUNDS=15
WATCHDOG_MAX_DEEP_TOOL_ROUNDS=25
# Per-investigation rails, not the operating limit. Sized so an investigation can
# read the build logs it needs and still reach a conclusion; the USD ceiling below
# is what actually governs spend.
WATCHDOG_LLM_SCAN_TOKEN_BUDGET=200000
WATCHDOG_LLM_DEEP_SCAN_TOKEN_BUDGET=300000
# Reserved per investigation by admission control: the expected cost, not the rail above.
WATCHDOG_LLM_EXPECTED_INVESTIGATION_TOKENS=80000
WATCHDOG_LLM_EXPECTED_DEEP_INVESTIGATION_TOKENS=120000
# Backstop only: sized above what the USD cap buys at the cheapest plausible rate, so the
# cost ceiling is what actually binds.
WATCHDOG_LLM_DAILY_TOKEN_BUDGET=20000000
WATCHDOG_LLM_MANUAL_TOKEN_RESERVE=4000000
# The USD ceiling is authoritative. Automatic scans receive $25.00 and the
# remaining $5.00 stays available for operator-requested investigations.
WATCHDOG_LLM_DAILY_COST_BUDGET_USD=30.00
WATCHDOG_LLM_MANUAL_COST_RESERVE_USD=5.00
# Rate used to price a reservation before the call is made. Measured blended rate
# for claude-sonnet-4-6 is ~$3.68/M. Setting this far above the real rate makes a
# single scan reserve many times what it spends and starve its own later
# investigations. Raise it when a more expensive model is configured.
WATCHDOG_LLM_MAX_TOKEN_COST_USD_PER_MILLION=5.00
WATCHDOG_LLM_TRIAGE_BATCH_SIZE=50
WATCHDOG_LLM_TRIAGE_TOKEN_BUDGET=8000
# Emergency per-cycle ceilings, not collection limits. Keep above the number of
# incidents a single scan can surface, or candidates are deferred on count alone.
WATCHDOG_MAX_INVESTIGATIONS_PER_SCAN=30
WATCHDOG_MAX_DEEP_INVESTIGATIONS_PER_SCAN=20

# Jenkins API access. Without these, the jenkins_jobs/jenkins_failed_builds/
# jenkins_agent_connectivity checks fail gracefully (logged, zero findings).
WATCHDOG_JENKINS_URL=http://jenkins.jenkins.svc.cluster.local:8080
WATCHDOG_JENKINS_USER=
WATCHDOG_JENKINS_TOKEN=
# All-job window collection takes about one minute for the current Jenkins catalog.
WATCHDOG_JENKINS_FAILED_BUILD_CHECK_TIMEOUT_S=120
# Durable all-job metadata ingestion. Logs are fetched only for bounded
# failure-enrichment batches; external Jenkins access remains read-only.
WATCHDOG_JENKINS_MONITOR_ENABLED=true
WATCHDOG_JENKINS_SYNC_INTERVAL_S=300
WATCHDOG_JENKINS_SYNC_WINDOW_HOURS=168
WATCHDOG_JENKINS_SYNC_CONCURRENCY=10
WATCHDOG_JENKINS_SYNC_ENRICHMENT_LIMIT=250
WATCHDOG_JENKINS_SYNC_LOG_LIMIT=30
# Source attribution runs independently from log enrichment. Profiles declare
# root-job repository contracts; Jenkins evidence identifies the concrete source.
WATCHDOG_JENKINS_SOURCE_ATTRIBUTION_LIMIT=500
WATCHDOG_JENKINS_SOURCE_PROFILES_PATH=config/source-profiles.yaml
# Tokens verify and enrich detected sources even when provider writes are disabled.
WATCHDOG_GITHUB_API_URL=https://api.github.com
WATCHDOG_GITHUB_TOKEN=
WATCHDOG_GITLAB_API_URL=https://gitlab.com/api/v4
WATCHDOG_GITLAB_TOKEN=
WATCHDOG_AUTOMATIC_INVESTIGATIONS_ENABLED=true
WATCHDOG_AUTOMATIC_INVESTIGATION_MIN_PRIORITY=1
WATCHDOG_AUTOMATIC_INVESTIGATION_BATCH_SIZE=250
WATCHDOG_KUBECONFIG_PATH=
WATCHDOG_KUBERNETES_ENVIRONMENT=k3s-devops-prod
WATCHDOG_EMAIL_ENABLED=false
WATCHDOG_EMAIL_FALLBACK_RECIPIENTS=
WATCHDOG_LOCAL_ACTOR_EMAIL=

# No local Prometheus by default — disable to avoid noisy connection errors
# from the resource-pressure check. Set to true if you have one reachable.
WATCHDOG_PROMETHEUS_ENABLED=false

# Jira ticket creation from findings. Optional — leave blank to skip.
WATCHDOG_JIRA_USER_EMAIL=
WATCHDOG_JIRA_API_TOKEN=

# WATCHDOG_OIDC_ISSUER is deliberately left unset: an empty issuer disables
# auth entirely, which is what you want for local dev.

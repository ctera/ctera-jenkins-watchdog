# Copy to .env and fill in what you need: `cp .env.example .env`
# .env is gitignored and auto-loaded by pydantic-settings (see src/jenkins_watchdog/config.py).
#
# Port and Valkey vars are intentionally NOT set here — scripts/dev.sh injects
# per-instance values (WATCHDOG_PORT, WATCHDOG_VALKEY_HOST/PORT) automatically
# so multiple git-worktree instances don't collide. Don't set them in .env.

# Required for LLM-based investigation (Claude tool-use). Without it, scans still
# run and detect findings, but investigations are skipped.
#
# Mint one with `claude setup-token`. Put it ONLY here — do not `export` it in your
# shell: the app hands it to the Claude Code subprocess itself, so exporting it
# globally would retarget every other `claude` on your machine to this identity.
# An ANTHROPIC_API_KEY will NOT work: an OAuth token has no quota against the raw
# Messages API, so the Agent SDK is the only path it authenticates on.
WATCHDOG_CLAUDE_CODE_OAUTH_TOKEN=

# Jenkins API access. Without these, the jenkins_jobs/jenkins_failed_builds/
# jenkins_agent_connectivity checks fail gracefully (logged, zero findings).
WATCHDOG_JENKINS_URL=http://jenkins.jenkins.svc.cluster.local:8080
WATCHDOG_JENKINS_USER=
WATCHDOG_JENKINS_TOKEN=

# No local Prometheus by default — disable to avoid noisy connection errors
# from the resource-pressure check. Set to true if you have one reachable.
WATCHDOG_PROMETHEUS_ENABLED=false

# Jira ticket creation from findings. Optional — leave blank to skip.
WATCHDOG_JIRA_USER_EMAIL=
WATCHDOG_JIRA_API_TOKEN=

# WATCHDOG_OIDC_ISSUER is deliberately left unset: an empty issuer disables
# auth entirely, which is what you want for local dev.
